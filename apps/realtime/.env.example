# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.
# Đây là máy chủ, không chạy trên trình duyệt, nên được phép giữ khóa bí mật.

# Cổng máy chủ realtime.
PORT=2567

# URL dự án Supabase.
SUPABASE_URL=

# Khóa publishable của Supabase (công khai).
SUPABASE_PUBLISHABLE_KEY=

# Khóa BÍ MẬT của Supabase (dạng sb_secret_..., trước đây là service_role).
# Khóa này bỏ qua mọi RLS: TUYỆT ĐỐI KHÔNG đưa lên trình duyệt, không đặt vào apps/web hay apps/admin
# với tiền tố NEXT_PUBLIC_, không commit lên Git.
SUPABASE_SECRET_KEY=
