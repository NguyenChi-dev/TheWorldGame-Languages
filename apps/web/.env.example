# Sao chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
#
# Biến bắt đầu bằng NEXT_PUBLIC_ sẽ được gửi xuống trình duyệt: ai cũng đọc được.
# Vì vậy chỉ đặt giá trị công khai vào biến NEXT_PUBLIC_.

# URL dự án Supabase (công khai).
NEXT_PUBLIC_SUPABASE_URL=

# Khóa publishable của Supabase (công khai, dạng sb_publishable_...). An toàn ở trình duyệt vì có RLS bảo vệ.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Địa chỉ máy chủ realtime (Colyseus). Để trống sẽ dùng ws://localhost:2567.
NEXT_PUBLIC_REALTIME_URL=

# Địa chỉ máy chủ apps/api (backend xử lý vàng, nông trại, mua bán, bài học).
# Để trống sẽ dùng http://localhost:4000.
NEXT_PUBLIC_API_URL=

# TUYỆT ĐỐI KHÔNG thêm khóa bí mật (SUPABASE_SERVICE_ROLE_KEY, secret) với tiền tố NEXT_PUBLIC_.
# Khóa bí mật bỏ qua mọi RLS. Nếu lộ ra trình duyệt, ai cũng sửa được dữ liệu của mọi người chơi.
