# Sao chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
#
# Biến bắt đầu bằng NEXT_PUBLIC_ sẽ được gửi xuống trình duyệt: ai cũng đọc được.

# URL dự án Supabase (công khai).
NEXT_PUBLIC_SUPABASE_URL=

# Khóa publishable của Supabase (công khai, dạng sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Địa chỉ máy chủ apps/api. Trang admin gọi các route /admin/... ở đây.
# Để trống sẽ dùng http://localhost:4000.
NEXT_PUBLIC_API_URL=

# TUYỆT ĐỐI KHÔNG đặt khóa bí mật (SUPABASE_SERVICE_ROLE_KEY, secret) vào biến NEXT_PUBLIC_.
# Trang admin cũng chạy trên trình duyệt; quyền sửa nội dung phải đến từ vai trò admin + RLS,
# không phải từ khóa bí mật.

# Cloudinary (lưu ảnh/âm thanh cho trang Media). Lấy ở Cloudinary Console → Settings → API Keys.
# Dạng: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CHỨA KHÓA BÍ MẬT: chỉ máy chủ đọc, KHÔNG đặt tên NEXT_PUBLIC_..., KHÔNG commit giá trị thật.
CLOUDINARY_URL=
# Thư mục gốc trên Cloudinary cho ảnh tải lên từ admin. Để trống = language-world.
CLOUDINARY_FOLDER=
