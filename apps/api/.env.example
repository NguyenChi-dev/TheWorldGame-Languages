# Sao chép file này thành .env (cùng thư mục apps/api) rồi điền giá trị. KHÔNG commit file .env.
# apps/api là máy chủ, không chạy trên trình duyệt, nên được phép giữ khóa bí mật.

# Cổng của máy chủ API. Để trống sẽ dùng 4000.
PORT=4000

# URL dự án Supabase, ví dụ https://abcdefgh.supabase.co
# Để trống thì máy chủ vẫn chạy, nhưng route cần đăng nhập trả 503 "Chưa cấu hình Supabase".
SUPABASE_URL=

# KHÓA BÍ MẬT của Supabase (service_role, hoặc khóa mới dạng sb_secret_...).
# Khóa này bỏ qua mọi RLS, đọc/sửa được dữ liệu của MỌI người chơi.
# TUYỆT ĐỐI KHÔNG đưa vào apps/web hay apps/admin, không đặt tên NEXT_PUBLIC_..., không commit lên Git.
SUPABASE_SERVICE_ROLE_KEY=

# Các trang web được phép gọi API, cách nhau bằng dấu phẩy, không có "/" ở cuối.
# Để trống sẽ dùng: http://localhost:3000,http://localhost:3001 (web và admin khi chạy trên máy).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
